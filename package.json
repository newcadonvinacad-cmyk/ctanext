{
  "name": "signage-erp-ai",
  "version": "1.0.0",
  "description": "Hệ thống Quản trị Doanh nghiệp Biển Quảng Cáo (Next.js & Supabase)",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:production": "node tests/run-production-tests.cjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run typecheck && npm test",
    "db:status": "node scripts/database.mjs status",
    "db:verify": "node scripts/database.mjs verify",
    "db:check": "node scripts/database.mjs check",
    "db:migrate": "node scripts/database.mjs apply",
    "check:release": "npm run check && npm run db:verify && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.103.2",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.14",
    "next": "^15.2.0",
    "opentype.js": "^2.0.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.13.9",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
